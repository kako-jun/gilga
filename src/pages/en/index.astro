---
import Layout from '@/layouts/Layout.astro';
import ToolCard from '@/components/ToolCard.astro';
import LangSwitcher from '@/components/LangSwitcher.astro';
import Footer from '@/components/Footer.astro';
import { getToolCards } from '@/data/tools';

const cards = getToolCards('en');
---

<Layout
  title="Gilga — The tongue that tastes malice"
  description="An outlaw using technology to protect those exploited by the knowledge gap. A collection of free, in-browser tools."
  lang="en"
>
  <header class="max-w-5xl w-full mx-auto px-6 pt-6 flex items-center justify-between">
    <a href="/en/" class="flex items-center gap-2 group" aria-label="Gilga home">
      <span class="text-2xl" aria-hidden="true">👅</span>
      <span
        class="text-xl font-bold tracking-wider text-white group-hover:text-purple-300 transition-colors"
      >
        Gilga
      </span>
    </a>
    <LangSwitcher lang="en" />
  </header>

  <main class="flex-1 w-full max-w-5xl mx-auto px-6 pt-16 pb-12">
    <section class="text-center mb-16">
      <h1
        class="text-4xl sm:text-5xl font-bold mb-4 bg-gradient-to-r from-purple-300 via-white to-purple-300 bg-clip-text text-transparent"
      >
        The tongue that tastes malice.
      </h1>
      <p class="text-lg text-gray-300 mb-2">
        An outlaw using technology to protect people exploited by the knowledge gap.
      </p>
      <p class="text-sm text-gray-500">
        Every tool runs in your browser. Your data never reaches our servers.
      </p>
    </section>

    <section aria-label="Tools">
      <h2 class="sr-only">Tools</h2>
      <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {
          cards.map((card) => (
            <li>
              <ToolCard
                icon={card.icon}
                title={card.title}
                description={card.description}
                href={card.href}
                comingSoonLabel={card.status === 'coming-soon' ? 'Soon' : undefined}
              />
            </li>
          ))
        }
      </ul>
    </section>
  </main>

  <Footer lang="en" />
</Layout>
