---
import Layout from '@/layouts/Layout.astro';
import LangSwitcher from '@/components/LangSwitcher.astro';
import Footer from '@/components/Footer.astro';
import TrackerDetector from '@/components/TrackerDetector.astro';
---

<Layout
  title="Tracking Pixel Detector — Gilga"
  description="Detect tracking pixels hidden inside marketing email HTML. Reveals open-tracking beacons fully inside your browser — nothing is uploaded."
  lang="en"
>
  <header class="max-w-5xl w-full mx-auto px-6 pt-6 flex items-center justify-between">
    <a href="/en/" class="flex items-center gap-2 group" aria-label="Gilga home">
      <span class="text-2xl" aria-hidden="true">👅</span>
      <span
        class="text-xl font-bold tracking-wider text-white group-hover:text-purple-300 transition-colors"
      >
        Gilga
      </span>
    </a>
    <LangSwitcher lang="en" />
  </header>

  <main class="flex-1 w-full max-w-5xl mx-auto px-6 pt-12 pb-12">
    <nav class="text-xs text-gray-500 mb-6">
      <a href="/en/" class="hover:text-purple-300">Home</a>
      <span class="mx-2">/</span>
      <span class="text-gray-400">Tracking Pixel Detector</span>
    </nav>

    <section class="text-center mb-12">
      <div class="text-5xl mb-4" aria-hidden="true">👁️</div>
      <h1
        class="text-3xl sm:text-4xl font-bold mb-4 bg-gradient-to-r from-purple-300 via-white to-purple-300 bg-clip-text text-transparent"
      >
        Tracking Pixel Detector
      </h1>
      <p class="text-base text-gray-300 max-w-2xl mx-auto">
        Marketing emails almost always embed a
        <strong class="text-red-400">1×1 invisible pixel</strong>. The moment you open
        the email, that image loads &mdash; and the sender's server is silently notified
        <strong class="text-red-400">that you opened it</strong>.
      </p>
      <p class="text-sm text-gray-500 mt-3 max-w-2xl mx-auto">
        This page parses the HTML entirely inside your browser. Nothing is uploaded.
      </p>
    </section>

    <TrackerDetector lang="en" />

    <section class="mt-16 max-w-2xl mx-auto text-sm text-gray-400 space-y-4">
      <h2 class="text-base font-semibold text-purple-300">How it works</h2>
      <ol class="list-decimal list-inside space-y-2 text-gray-400">
        <li>
          Use "View source" in your email client and paste the raw HTML into the textarea.
        </li>
        <li>
          The browser's <code class="text-purple-300">DOMParser</code> parses the HTML
          and extracts every <code class="text-purple-300">&lt;img&gt;</code> tag.
        </li>
        <li>
          Each image's hostname is matched against a list of known email service providers
          (Mailchimp, HubSpot, SendGrid, etc.). Images that are 1×1 or hidden via
          <code class="text-purple-300">display:none</code> are also flagged as suspects.
        </li>
        <li>
          <code class="text-purple-300">url()</code> inside
          <code class="text-purple-300">&lt;style&gt;</code> tags is also checked.
          We never actually fetch any of those URLs.
        </li>
      </ol>
      <p class="text-xs text-gray-500">
        Note: tracking pixels are legal and used by nearly every marketing email. The
        simplest defense is to disable automatic image loading in your email client
        (Apple Mail Privacy Protection, Gmail's image proxy, etc.).
      </p>
    </section>
  </main>

  <Footer lang="en" />
</Layout>
