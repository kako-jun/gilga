---
import Layout from '@/layouts/Layout.astro';
import LangSwitcher from '@/components/LangSwitcher.astro';
import Footer from '@/components/Footer.astro';
import ExifStripper from '@/components/ExifStripper.astro';
---

<Layout
  title="Photo Metadata Stripper — Gilga"
  description="Analyze and strip GPS coordinates and device info from your photos — fully in your browser. Nothing is uploaded."
  lang="en"
>
  <header class="max-w-5xl w-full mx-auto px-6 pt-6 flex items-center justify-between">
    <a href="/en/" class="flex items-center gap-2 group" aria-label="Gilga home">
      <span class="text-2xl" aria-hidden="true">👅</span>
      <span
        class="text-xl font-bold tracking-wider text-white group-hover:text-purple-300 transition-colors"
      >
        Gilga
      </span>
    </a>
    <LangSwitcher lang="en" />
  </header>

  <main class="flex-1 w-full max-w-5xl mx-auto px-6 pt-12 pb-12">
    <nav class="text-xs text-gray-500 mb-6">
      <a href="/en/" class="hover:text-purple-300">Home</a>
      <span class="mx-2">/</span>
      <span class="text-gray-400">Photo Metadata Stripper</span>
    </nav>

    <section class="text-center mb-12">
      <div class="text-5xl mb-4" aria-hidden="true">📷</div>
      <h1
        class="text-3xl sm:text-4xl font-bold mb-4 bg-gradient-to-r from-purple-300 via-white to-purple-300 bg-clip-text text-transparent"
      >
        Photo Metadata Stripper
      </h1>
      <p class="text-base text-gray-300 max-w-2xl mx-auto">
        Photos from your phone silently carry
        <strong class="text-red-400">GPS coordinates</strong>, the
        <strong class="text-red-400">device model</strong> and the timestamp as EXIF data.
        Post them to social media as-is and strangers can pinpoint your home or daily routine.
      </p>
      <p class="text-sm text-gray-500 mt-3 max-w-2xl mx-auto">
        This page never uploads your file. Everything is analyzed and stripped inside your browser.
      </p>
    </section>

    <ExifStripper lang="en" />

    <section class="mt-16 max-w-2xl mx-auto text-sm text-gray-400 space-y-4">
      <h2 class="text-base font-semibold text-purple-300">How it works</h2>
      <ol class="list-decimal list-inside space-y-2 text-gray-400">
        <li>The image is loaded into browser memory (never uploaded).</li>
        <li>
          <a
            href="https://github.com/MikeKovarik/exifr"
            target="_blank"
            rel="noopener noreferrer"
            class="text-purple-300 underline hover:text-purple-200">exifr</a
          > parses the EXIF block to extract GPS, timestamps and device fields.
        </li>
        <li>
          The image is redrawn through Canvas and re-encoded as JPEG (PNG stays PNG). EXIF
          does not survive the round-trip.
        </li>
        <li>The cleaned file is saved locally. The original on disk is not modified.</li>
      </ol>
      <p class="text-xs text-gray-500">
        Note: some social platforms strip EXIF on upload, but chat apps (Discord, Slack) and
        email attachments preserve it.
      </p>
    </section>
  </main>

  <Footer lang="en" />
</Layout>
