---
import Layout from '@/layouts/Layout.astro';
import LangSwitcher from '@/components/LangSwitcher.astro';
import Footer from '@/components/Footer.astro';
import UrlUnshortener from '@/components/UrlUnshortener.astro';
---

<Layout
  title="URL Unshortener — Gilga"
  description="Reveal where bit.ly or t.co really sends you, without clicking. Cloudflare Workers follows redirect headers only — we never fetch the page body."
  lang="en"
>
  <header class="max-w-5xl w-full mx-auto px-6 pt-6 flex items-center justify-between">
    <a href="/en/" class="flex items-center gap-2 group" aria-label="Gilga home">
      <span class="text-2xl" aria-hidden="true">👅</span>
      <span
        class="text-xl font-bold tracking-wider text-white group-hover:text-purple-300 transition-colors"
      >
        Gilga
      </span>
    </a>
    <LangSwitcher lang="en" />
  </header>

  <main class="flex-1 w-full max-w-5xl mx-auto px-6 pt-12 pb-12">
    <nav class="text-xs text-gray-500 mb-6">
      <a href="/en/" class="hover:text-purple-300">Home</a>
      <span class="mx-2">/</span>
      <span class="text-gray-400">URL Unshortener</span>
    </nav>

    <section class="text-center mb-12">
      <div class="text-5xl mb-4" aria-hidden="true">🔗</div>
      <h1
        class="text-3xl sm:text-4xl font-bold mb-4 bg-gradient-to-r from-purple-300 via-white to-purple-300 bg-clip-text text-transparent"
      >
        URL Unshortener
      </h1>
      <p class="text-base text-gray-300 max-w-2xl mx-auto">
        Shortened links from <strong class="text-red-400">bit.ly</strong>,
        <strong class="text-red-400">t.co</strong>, lnkd.in and friends hide
        where they actually take you. They are also a favourite weapon of
        phishing. Paste one here and our Cloudflare Worker follows the redirects
        in your place to reveal
        <strong class="text-purple-300">where the link really lands</strong>.
      </p>
      <p class="text-sm text-gray-500 mt-3 max-w-2xl mx-auto">
        The Worker never reads the page body — only the HTTP Location headers.
      </p>
    </section>

    <UrlUnshortener lang="en" />

    <section class="mt-16 max-w-2xl mx-auto text-sm text-gray-400 space-y-4">
      <h2 class="text-base font-semibold text-purple-300">How it works</h2>
      <ol class="list-decimal list-inside space-y-2 text-gray-400">
        <li>
          Your browser sends a GET to
          <code class="text-purple-300">/api/unshorten?url=...</code>.
        </li>
        <li>
          The Cloudflare Worker parses the URL and rejects anything that is not
          <code class="text-purple-300">http</code> /
          <code class="text-purple-300">https</code>, plus localhost and private
          IPs (10.x, 192.168.x, 172.16-31.x, 169.254.x, ::1, etc.) as SSRF
          protection.
        </li>
        <li>
          The Worker calls
          <code class="text-purple-300">fetch(url, &#123; redirect: 'manual' &#125;)</code>
          one hop at a time and follows the
          <code class="text-purple-300">Location</code> header on 3xx responses.
        </li>
        <li>
          Each hop has a 5-second timeout, with an overall cap of 15 seconds and
          10 hops.
        </li>
        <li>
          The response body is discarded immediately — saves memory and
          bandwidth, and is also a deliberate signal that we don't read the page.
        </li>
        <li>
          The hostname and status code of each hop are returned as JSON and
          rendered in your browser.
        </li>
      </ol>
      <p class="text-xs text-gray-500">
        Note: Worker logs keep only hostnames — full URLs and IPs are never
        persisted. You are still not perfectly anonymous (Cloudflare's edge sees
        your IP), so for genuinely suspicious URLs route the request through a
        VPN or Tor.
      </p>
    </section>
  </main>

  <Footer lang="en" />
</Layout>
