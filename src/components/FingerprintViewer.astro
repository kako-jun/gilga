        labelTzOffset: 'UTC オフセット (分)',
        labelCanvasHash: 'Canvas SHA-256 (先頭 16 桁)',
        labelWebglVendor: 'GPU ベンダー',
        labelWebglRenderer: 'GPU レンダラ',
        labelAudioHash: 'AudioContext シグネチャ',
        labelFontsFound: '検出フォント数',
        labelFontsList: '検出されたフォント',
        labelPlugins: 'プラグイン',
        labelMimeTypes: 'MIME タイプ',
        bitsBadge: '{N} bit',
        unsupported: '取得不可',
