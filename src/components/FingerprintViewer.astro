      }
    : {
        clientOnly:
          'We never send anything. Everything runs inside your browser.',
        consentHeading: 'Consent-based measurement',
        consentBody:
          'This page collects nothing until you press the button. The moment you press "Measure", it reads values from your browser and displays them. Nothing is uploaded, nothing is stored. The result disappears on reload.',
        measure: 'Measure',
        measuring: 'Measuring…',
        remeasure: 'Measure again',
        scoreHeading: 'Your fingerprint uniqueness',
        scoreBits: '~{N} bits',
        scoreOneIn: 'About 1 in {N} people share your fingerprint',
        scoreOfWorld: 'Out of {N} (world population)',
        scoreVeryUnique: 'Almost certainly unique on Earth',
        scoreRare: 'Quite rare',
        scoreCommon: 'Common configuration',
        sectionBasic: 'Basics',
        sectionScreen: 'Screen / Display',
        sectionTimezone: 'Timezone',
        sectionCanvas: 'Canvas fingerprint',
        sectionWebGL: 'WebGL fingerprint',
        sectionAudio: 'AudioContext fingerprint',
        sectionFonts: 'Fonts',
        sectionPlugins: 'Plugins / MIME',
        labelUA: 'User-Agent',
        labelPlatform: 'Platform',
        labelLanguages: 'Languages',
        labelHardware: 'CPU cores',
        labelMemory: 'Device memory (GB)',
        labelCookies: 'Cookies enabled',
        labelDnt: 'Do Not Track',
        labelScreen: 'Resolution',
        labelColorDepth: 'Color depth',
        labelDpr: 'Pixel ratio',
        labelAvail: 'Available area',
        labelTimezone: 'Timezone',
        labelTzOffset: 'UTC offset (min)',
        labelCanvasHash: 'Canvas SHA-256 (first 16 hex)',
        labelWebglVendor: 'GPU vendor',
        labelWebglRenderer: 'GPU renderer',
        labelAudioHash: 'AudioContext signature',
        labelFontsFound: 'Fonts detected',
        labelFontsList: 'Detected fonts',
        labelPlugins: 'Plugins',
        labelMimeTypes: 'MIME types',
        bitsBadge: '{N} bit',
        unsupported: 'Unavailable',
        none: 'None',
        dntNotSet: 'Not set',
        dntOn: 'On (1)',
        dntOff: 'Off (0)',
        defendHeading: 'How to defend',
        defendIntro:
          'There is no way to drop your fingerprint to zero. The options below either make you look like everyone else, or disable specific APIs. Links do not connect to anything until you click them.',
        warningNote:
          'Note: the bits shown here are estimates. Real-world tracking accuracy depends on the size of the tracker\'s database. Treat the number as a rough sense of how unusual your combination is.',
      };

// 防御リンク（ユーザーがクリックするまで通信しない）
const defenses =
  lang === 'ja'
    ? [
        {
          name: 'Tor Browser',
          desc: '指紋を全ユーザーで同一に揃える設計。匿名性最強。',
          url: 'https://www.torproject.org/',
        },
        {
          name: 'Brave Browser',
          desc: 'Canvas / WebGL / Audio API をデフォルトで難読化（ランダム化）。',
          url: 'https://brave.com/',
        },
        {
          name: 'Firefox + resistFingerprinting',
          desc: 'about:config で privacy.resistFingerprinting を true にすると Tor 同様の動作になる。',
          url: 'https://support.mozilla.org/kb/firefox-protection-against-fingerprinting',
        },
        {
          name: 'LibreWolf',
          desc: 'Firefox ベースで、resistFingerprinting がデフォルト ON。',
          url: 'https://librewolf.net/',
        },
        {
          name: 'uBlock Origin',
          desc: 'トラッカー側のスクリプト読み込み自体をブロックする。',
          url: 'https://ublockorigin.com/',
        },
        {
          name: 'CanvasBlocker (Firefox)',
          desc: 'Canvas/WebGL/Audio API を細かく制御。フェイク値の返却も可能。',
          url: 'https://addons.mozilla.org/firefox/addon/canvasblocker/',
        },
      ]
    : [
        {
          name: 'Tor Browser',
          desc: 'Designed so every Tor user looks identical. The strongest anti-fingerprint browser.',
          url: 'https://www.torproject.org/',
        },
        {
          name: 'Brave Browser',
          desc: 'Randomizes Canvas / WebGL / Audio APIs by default.',
          url: 'https://brave.com/',
        },
        {
          name: 'Firefox + resistFingerprinting',
          desc: 'Set privacy.resistFingerprinting in about:config to behave like Tor.',
          url: 'https://support.mozilla.org/kb/firefox-protection-against-fingerprinting',
        },
        {
          name: 'LibreWolf',
          desc: 'Firefox fork with resistFingerprinting enabled by default.',
          url: 'https://librewolf.net/',
        },
        {
          name: 'uBlock Origin',
          desc: 'Blocks the fingerprinting scripts before they even load.',
          url: 'https://ublockorigin.com/',
        },
        {
          name: 'CanvasBlocker (Firefox)',
          desc: 'Granular control of Canvas / WebGL / Audio APIs, including fake responses.',
          url: 'https://addons.mozilla.org/firefox/addon/canvasblocker/',
        },
      ];

/**
 * ビット数の見積もり（{@link copy} の見出しと対応）。
 * unsupported のときは加点しない。
 */
const BITS = {
  canvas: 18,
  webgl: 8,
  fonts: 12,
  screen: 5,
  timezone: 5,
  ua: 10,
  audio: 6,
  languages: 3,
  hardware: 3,
  plugins: 2,
};

// 控えめ係数（重複あり）
const BIT_DISCOUNT = 0.7;

// 比較に使う「世界人口」近似
const WORLD_POPULATION = 8_000_000_000;
---

<section
  class="w-full max-w-3xl mx-auto"
  data-fingerprint-viewer
  data-copy={JSON.stringify(copy)}
  data-bits={JSON.stringify(BITS)}
  data-bit-discount={BIT_DISCOUNT}
  data-world-population={WORLD_POPULATION}
>
  <p
    class="text-sm text-purple-300 border border-purple-500/40 bg-purple-500/10 rounded-md px-4 py-3 mb-6 flex items-start gap-2"
  >
    <span aria-hidden="true">🛡️</span>
    <span>{copy.clientOnly}</span>
  </p>

  <div
    class="border border-gray-700 bg-gray-900/40 rounded-lg px-4 py-4 mb-6"
    data-consent-panel
  >
    <p class="text-sm font-semibold text-purple-300 mb-2">
      {copy.consentHeading}
    </p>
    <p class="text-xs text-gray-400 mb-4">{copy.consentBody}</p>
    <button
      type="button"
      data-measure-btn
      class="px-4 py-2 rounded-lg bg-purple-600 hover:bg-purple-500 text-white font-semibold transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-purple-300 disabled:opacity-60"
    >
      {copy.measure}
    </button>
  </div>

  <div class="hidden" data-result aria-live="polite">
    <div
      class="border border-purple-500/40 bg-gradient-to-br from-purple-900/30 to-gray-900/40 rounded-lg px-5 py-5 mb-6 text-center"
      data-score-panel
    >
      <p class="text-xs uppercase tracking-wider text-purple-300 mb-2">
        {copy.scoreHeading}
      </p>
      <p class="text-4xl font-bold text-white mb-2" data-score-bits></p>
      <p class="text-sm text-gray-300" data-score-oneinn></p>
      <p class="text-[10px] text-gray-500 mt-2" data-score-verdict></p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4" data-sections></div>

    <p class="text-xs text-gray-500 border-t border-gray-800 pt-4 mt-6">
      {copy.warningNote}
    </p>
  </div>

  <section class="mt-12">
    <h2 class="text-base font-semibold text-purple-300 mb-3">
      {copy.defendHeading}
    </h2>
    <p class="text-xs text-gray-400 mb-4">{copy.defendIntro}</p>
    <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3">
      {
        defenses.map((d) => (
          <li class="border border-gray-700 hover:border-purple-500/60 transition-colors rounded-md px-3 py-3 bg-gray-900/30">
            <a
              href={d.url}
              target="_blank"
              rel="noopener noreferrer"
              class="block group"
            >
              <p class="text-sm text-white font-semibold group-hover:text-purple-300 transition-colors mb-1">
                {d.name}
              </p>
              <p class="text-xs text-gray-400">{d.desc}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</section>

<script>
  type Copy = Record<string, string>;
  type Bits = {
    canvas: number;
    webgl: number;
    fonts: number;
    screen: number;
    timezone: number;
    ua: number;
    audio: number;
    languages: number;
    hardware: number;
    plugins: number;
  };

  type Row = {
    label: string;
    value: string;
    mono?: boolean;
  };

  type Section = {
    title: string;
    bits: number | null; // null は加点なし
    rows: Row[];
  };

  /** Uint8Array → 先頭 N バイトの hex 文字列 */
  const toHex = (bytes: Uint8Array, n: number): string => {
    const limit = Math.min(bytes.length, n);
    let s = '';
    for (let i = 0; i < limit; i++) {
      s += bytes[i].toString(16).padStart(2, '0');
    }
    return s;
  };

  /** SubtleCrypto SHA-256（fingerprintingに使う、外部送信なし） */
  const sha256Hex = async (input: string, head: number): Promise<string> => {
    try {
      const enc = new TextEncoder().encode(input);
      const buf = await crypto.subtle.digest('SHA-256', enc);
      return toHex(new Uint8Array(buf), head);
    } catch {
      return '';
    }
  };

  /** Canvas 指紋: 絵文字 + 多言語 + グラデ + 図形を描き toDataURL を hash */
  const collectCanvasHash = async (): Promise<string> => {
    try {
      const canvas = document.createElement('canvas');
      canvas.width = 280;
      canvas.height = 80;
      const ctx = canvas.getContext('2d');
      if (!ctx) return '';

      // グラデーション
      const grad = ctx.createLinearGradient(0, 0, 280, 80);
      grad.addColorStop(0, '#7e22ce');
      grad.addColorStop(0.5, '#ffffff');
      grad.addColorStop(1, '#22c55e');
      ctx.fillStyle = grad;
      ctx.fillRect(0, 0, 280, 80);

      // 図形（円 + 三角）
      ctx.fillStyle = 'rgba(255,127,0,0.7)';
      ctx.beginPath();
      ctx.arc(60, 40, 28, 0, Math.PI * 2);
      ctx.fill();

      ctx.strokeStyle = 'rgba(0,0,255,0.6)';
      ctx.lineWidth = 2;
      ctx.beginPath();
      ctx.moveTo(120, 60);
      ctx.lineTo(180, 60);
      ctx.lineTo(150, 10);
      ctx.closePath();
      ctx.stroke();

      // テキスト（絵文字 + 多言語 + 合字）
      ctx.font = '18px "Times New Roman", serif';
      ctx.fillStyle = '#111';
      ctx.fillText('Gilga 🕵️ 義賊 fi-ffi 0Oo', 8, 28);
      ctx.font = '14px Arial, sans-serif';
      ctx.fillStyle = '#000';
      ctx.fillText('指紋 fingerprint αβγ ✓', 8, 72);

      const dataUrl = canvas.toDataURL();
      return await sha256Hex(dataUrl, 8); // 16 桁
    } catch {
      return '';
    }
  };

  /** WebGL 指紋: vendor / renderer を取得 */
  const collectWebGL = (): { vendor: string; renderer: string } => {
    const result = { vendor: '', renderer: '' };
    try {
      const canvas = document.createElement('canvas');
      const gl =
        (canvas.getContext('webgl') as WebGLRenderingContext | null) ||
        (canvas.getContext(
          'experimental-webgl',
        ) as WebGLRenderingContext | null);
      if (!gl) return result;

      const dbg = gl.getExtension('WEBGL_debug_renderer_info');
      if (dbg) {
        const v = gl.getParameter(
          (dbg as { UNMASKED_VENDOR_WEBGL: number }).UNMASKED_VENDOR_WEBGL,
        );
        const r = gl.getParameter(
          (dbg as { UNMASKED_RENDERER_WEBGL: number }).UNMASKED_RENDERER_WEBGL,
        );
        if (typeof v === 'string') result.vendor = v;
        if (typeof r === 'string') result.renderer = r;
      }
      if (!result.vendor) {
        const v = gl.getParameter(gl.VENDOR);
        if (typeof v === 'string') result.vendor = v;
      }
      if (!result.renderer) {
        const r = gl.getParameter(gl.RENDERER);
        if (typeof r === 'string') result.renderer = r;
      }
    } catch {
      // ignore
    }
    return result;
  };

  /** AudioContext 指紋: OfflineAudioContext + Oscillator + Compressor */
  const collectAudio = async (): Promise<string> => {
    try {
      // OfflineAudioContext は Window 経由でしか型解決できない環境がある
      const Ctor: typeof OfflineAudioContext | undefined =
        (window as unknown as { OfflineAudioContext?: typeof OfflineAudioContext })
          .OfflineAudioContext ||
        (window as unknown as {
          webkitOfflineAudioContext?: typeof OfflineAudioContext;
        }).webkitOfflineAudioContext;
      if (!Ctor) return '';

      const ctx = new Ctor(1, 44100, 44100);
      const osc = ctx.createOscillator();
      osc.type = 'triangle';
      osc.frequency.value = 1000;

      const comp = ctx.createDynamicsCompressor();
      // パラメータをアサーション付きで設定（古い実装で setValueAtTime 不在対策）
      const setParam = (p: AudioParam, v: number): void => {
        try {
          p.setValueAtTime(v, 0);
        } catch {
          (p as unknown as { value: number }).value = v;
        }
      };
      setParam(comp.threshold, -50);
      setParam(comp.knee, 40);
      setParam(comp.ratio, 12);
      setParam(comp.attack, 0);
      setParam(comp.release, 0.25);

      osc.connect(comp);
      comp.connect(ctx.destination);
      osc.start(0);

      const buffer = await ctx.startRendering();
      const data = buffer.getChannelData(0);

      // 特定の範囲の絶対値和を取って 1 つの数字に
      let sum = 0;
      for (let i = 4500; i < 5000; i++) {
        sum += Math.abs(data[i]);
      }
      return sum.toFixed(8);
    } catch {
      return '';
    }
  };

  /** フォント検出: 既定 3 種に対する measureText 幅と比較し、検出されたフォント名一覧を返す */
  const collectFonts = (): string[] => {
    try {
      const candidates = [
        'Arial',
        'Helvetica',
        'Times New Roman',
        'Courier New',
        'Georgia',
        'Verdana',
        'Tahoma',
        'Trebuchet MS',
        'Comic Sans MS',
        'Impact',
        'MS PGothic',
        'MS Gothic',
        'Yu Gothic',
        'Meiryo',
        'Hiragino Kaku Gothic Pro',
        'Hiragino Mincho Pro',
        'SF Pro Display',
        'Roboto',
        'Source Code Pro',
        'Menlo',
      ];
      const baseFonts = ['monospace', 'sans-serif', 'serif'];
      const testString = 'mmmmmmmmmmlli WWWWWW あいう 漢字';
      const testSize = '72px';

      const canvas = document.createElement('canvas');
      canvas.width = 200;
      canvas.height = 200;
      const ctx = canvas.getContext('2d');
      if (!ctx) return [];

      // 各 base フォントでの幅をベースラインとして取得
      const baselineWidths: Record<string, number> = {};
      for (const base of baseFonts) {
        ctx.font = `${testSize} ${base}`;
        baselineWidths[base] = ctx.measureText(testString).width;
      }

      const detected: string[] = [];
      for (const font of candidates) {
        let differs = false;
        for (const base of baseFonts) {
          ctx.font = `${testSize} "${font}", ${base}`;
          const w = ctx.measureText(testString).width;
          if (w !== baselineWidths[base]) {
            differs = true;
            break;
          }
        }
        if (differs) detected.push(font);
      }
      return detected;
    } catch {
      return [];
    }
  };

  /** navigator.plugins / mimeTypes 名前一覧 */
  const collectPlugins = (): { plugins: string[]; mimeTypes: string[] } => {
    const plugins: string[] = [];
    const mimeTypes: string[] = [];
    try {
      const pl = navigator.plugins;
      if (pl) {
        for (let i = 0; i < pl.length; i++) {
          const p = pl[i];
          if (p && p.name) plugins.push(p.name);
        }
      }
    } catch {
      // ignore
    }
    try {
      const mt = navigator.mimeTypes;
      if (mt) {
        for (let i = 0; i < mt.length; i++) {
          const m = mt[i];
          if (m && m.type) mimeTypes.push(m.type);
        }
      }
    } catch {
      // ignore
    }
    return { plugins, mimeTypes };
  };

  const initOne = (root: HTMLElement): void => {
    let copy: Copy;
    let bits: Bits;
    let bitDiscount: number;
    let worldPop: number;
    try {
      copy = JSON.parse(root.dataset.copy || '{}') as Copy;
      bits = JSON.parse(root.dataset.bits || '{}') as Bits;
      bitDiscount = Number(root.dataset.bitDiscount || '0.7');
      worldPop = Number(root.dataset.worldPopulation || '8000000000');
    } catch {
      return;
    }

    const measureBtn = root.querySelector<HTMLButtonElement>('[data-measure-btn]');
    const resultEl = root.querySelector<HTMLElement>('[data-result]');
    const sectionsEl = root.querySelector<HTMLElement>('[data-sections]');
    const scoreBitsEl = root.querySelector<HTMLElement>('[data-score-bits]');
    const scoreOneInEl = root.querySelector<HTMLElement>('[data-score-oneinn]');
    const scoreVerdictEl = root.querySelector<HTMLElement>('[data-score-verdict]');

    if (
      !measureBtn ||
      !resultEl ||
      !sectionsEl ||
      !scoreBitsEl ||
      !scoreOneInEl ||
      !scoreVerdictEl
    ) {
      return;
    }

    const renderRow = (label: string, value: string, mono = false): HTMLElement => {
      const row = document.createElement('div');
      row.className = 'grid grid-cols-[110px_1fr] gap-2 text-xs';
      const l = document.createElement('span');
      l.className = 'text-gray-500 uppercase tracking-wider';
      l.textContent = label;
      const v = document.createElement('span');
      v.className = `break-all ${mono ? 'font-mono text-gray-300' : 'text-gray-200'}`;
      v.textContent = value;
      row.appendChild(l);
      row.appendChild(v);
      return row;
    };

    const renderSection = (section: Section): HTMLElement => {
      const div = document.createElement('div');
      div.className = 'border border-gray-700 bg-gray-900/40 rounded-md px-3 py-3';
      const head = document.createElement('div');
      head.className = 'flex items-center justify-between mb-2';
      const title = document.createElement('span');
      title.className = 'text-sm font-semibold text-purple-300';
      title.textContent = section.title;
      head.appendChild(title);
      if (section.bits != null && section.bits > 0) {
        const badge = document.createElement('span');
        badge.className =
          'text-[10px] px-2 py-0.5 rounded bg-purple-500/20 text-purple-300 font-mono';
        badge.textContent = copy.bitsBadge.replace('{N}', String(section.bits));
        head.appendChild(badge);
      }
      div.appendChild(head);
      const body = document.createElement('div');
      body.className = 'space-y-1';
      for (const row of section.rows) {
        body.appendChild(renderRow(row.label, row.value, row.mono === true));
      }
      div.appendChild(body);
      return div;
    };

    const formatNumber = (n: number): string => {
      // 大きい数値は短縮表記、小さければそのまま
      if (!Number.isFinite(n) || n < 0) return '∞';
      if (n >= 1e12) return (n / 1e12).toFixed(2) + 'T';
      if (n >= 1e9) return (n / 1e9).toFixed(2) + 'B';
      if (n >= 1e6) return (n / 1e6).toFixed(2) + 'M';
      if (n >= 1e3) return Math.round(n).toLocaleString();
      return String(Math.max(1, Math.round(n)));
    };

    const runMeasurement = async (): Promise<void> => {
      measureBtn.disabled = true;
      const originalLabel = measureBtn.textContent;
      measureBtn.textContent = copy.measuring;

      try {
        // 1. 基本
        const ua = navigator.userAgent || '';
        const platform = navigator.platform || '';
        const langs = (navigator.languages || [navigator.language || '']).join(
          ',',
        );
        const cores = navigator.hardwareConcurrency;
        const memory = (
          navigator as Navigator & { deviceMemory?: number }
        ).deviceMemory;
        const cookies = navigator.cookieEnabled === true;
        const dntRaw = (
          navigator as Navigator & { doNotTrack?: string | null }
        ).doNotTrack;

        const dntText =
          dntRaw == null || dntRaw === 'unspecified' || dntRaw === ''
            ? copy.dntNotSet
            : dntRaw === '1' || dntRaw === 'yes'
              ? copy.dntOn
              : copy.dntOff;

        // 2. 画面
        const sw = screen.width;
        const sh = screen.height;
        const cd = screen.colorDepth;
        const dpr = window.devicePixelRatio || 1;
        const aw = screen.availWidth;
        const ah = screen.availHeight;

        // 3. タイムゾーン
        let tz = '';
        try {
          tz = Intl.DateTimeFormat().resolvedOptions().timeZone || '';
        } catch {
          tz = '';
        }
        const tzOffset = new Date().getTimezoneOffset();

        // 4. Canvas（async）
        const canvasHash = await collectCanvasHash();

        // 5. WebGL
        const webgl = collectWebGL();

        // 6. Audio（async）
        const audioSig = await collectAudio();

        // 7. Fonts
        const fonts = collectFonts();

        // 8. Plugins / MimeTypes
        const { plugins, mimeTypes } = collectPlugins();

        // スコア集計
        let totalBits = 0;
        totalBits += bits.ua;
        totalBits += bits.languages;
        totalBits += bits.hardware;
        totalBits += bits.screen;
        totalBits += bits.timezone;
        if (canvasHash) totalBits += bits.canvas;
        if (webgl.vendor || webgl.renderer) totalBits += bits.webgl;
        if (audioSig) totalBits += bits.audio;
        if (fonts.length > 0) totalBits += bits.fonts;
        if (plugins.length > 0 || mimeTypes.length > 0)
          totalBits += bits.plugins;

        const discounted = totalBits * bitDiscount;
        const cappedBits = Math.min(64, Math.max(0, discounted));
        // 「N 人に 1 人」= 2^cappedBits だが world pop で頭打ち
        const oneIn = Math.min(Math.pow(2, cappedBits), worldPop);

        scoreBitsEl.textContent = copy.scoreBits.replace(
          '{N}',
          cappedBits.toFixed(1),
        );
        scoreOneInEl.textContent = copy.scoreOneIn.replace(
          '{N}',
          formatNumber(oneIn),
        );

        // 判定文（cappedBits の絶対値で 3 段階）
        let verdict = copy.scoreCommon;
        if (cappedBits >= 33) verdict = copy.scoreVeryUnique;
        else if (cappedBits >= 22) verdict = copy.scoreRare;
        scoreVerdictEl.textContent =
          verdict + ' · ' + copy.scoreOfWorld.replace('{N}', formatNumber(worldPop));

        // セクション描画
        const sections: Section[] = [
          {
            title: copy.sectionBasic,
            bits: bits.ua + bits.languages + bits.hardware + bits.plugins,
            rows: [
              { label: copy.labelUA, value: ua || copy.unsupported, mono: true },
              { label: copy.labelPlatform, value: platform || copy.unsupported },
              { label: copy.labelLanguages, value: langs || copy.unsupported },
              {
                label: copy.labelHardware,
                value: cores != null ? String(cores) : copy.unsupported,
              },
              {
                label: copy.labelMemory,
                value: memory != null ? String(memory) : copy.unsupported,
              },
              {
                label: copy.labelCookies,
                value: cookies ? 'true' : 'false',
              },
              { label: copy.labelDnt, value: dntText },
            ],
          },
          {
            title: copy.sectionScreen,
            bits: bits.screen,
            rows: [
              { label: copy.labelScreen, value: `${sw} × ${sh}` },
              { label: copy.labelColorDepth, value: String(cd) },
              { label: copy.labelDpr, value: String(dpr) },
              { label: copy.labelAvail, value: `${aw} × ${ah}` },
            ],
          },
          {
            title: copy.sectionTimezone,
            bits: bits.timezone,
            rows: [
              { label: copy.labelTimezone, value: tz || copy.unsupported },
              { label: copy.labelTzOffset, value: String(tzOffset) },
            ],
          },
          {
            title: copy.sectionCanvas,
            bits: canvasHash ? bits.canvas : null,
            rows: [
              {
                label: copy.labelCanvasHash,
                value: canvasHash || copy.unsupported,
                mono: true,
              },
            ],
          },
          {
            title: copy.sectionWebGL,
            bits: webgl.vendor || webgl.renderer ? bits.webgl : null,
            rows: [
              {
                label: copy.labelWebglVendor,
                value: webgl.vendor || copy.unsupported,
                mono: true,
              },
              {
                label: copy.labelWebglRenderer,
                value: webgl.renderer || copy.unsupported,
                mono: true,
              },
            ],
          },
          {
            title: copy.sectionAudio,
            bits: audioSig ? bits.audio : null,
            rows: [
              {
                label: copy.labelAudioHash,
                value: audioSig || copy.unsupported,
                mono: true,
              },
            ],
          },
          {
            title: copy.sectionFonts,
            bits: fonts.length > 0 ? bits.fonts : null,
            rows: [
              { label: copy.labelFontsFound, value: String(fonts.length) },
              {
                label: copy.labelFontsList,
                value: fonts.length > 0 ? fonts.join(', ') : copy.none,
              },
            ],
          },
          {
            title: copy.sectionPlugins,
            bits:
              plugins.length > 0 || mimeTypes.length > 0 ? bits.plugins : null,
            rows: [
              {
                label: copy.labelPlugins,
                value: plugins.length > 0 ? plugins.join(', ') : copy.none,
              },
              {
                label: copy.labelMimeTypes,
                value:
                  mimeTypes.length > 0 ? mimeTypes.join(', ') : copy.none,
              },
            ],
          },
        ];

        sectionsEl.innerHTML = '';
        for (const s of sections) {
          sectionsEl.appendChild(renderSection(s));
        }

        resultEl.classList.remove('hidden');
        measureBtn.textContent = copy.remeasure;
      } catch {
        measureBtn.textContent = originalLabel;
      } finally {
        measureBtn.disabled = false;
      }
    };

    measureBtn.addEventListener('click', () => {
      void runMeasurement();
    });
  };

  const init = (): void => {
    document
      .querySelectorAll<HTMLElement>('[data-fingerprint-viewer]')
      .forEach(initOne);
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>
