---
/**
 * FingerprintViewer — クライアント完結のブラウザ指紋可視化ツール。
 *
 * - ユーザーが「測定する」ボタンを押した時にだけ指紋収集を開始する（同意ベース）
 * - 取得するのは UA / 画面 / タイムゾーン / Canvas / WebGL / AudioContext / フォント / plugins
 * - SHA-256 は SubtleCrypto でローカル計算。fetch / XHR / sendBeacon は一切呼ばない
 * - localStorage 等への保存もしない。リロードで結果は消える
 *
 * 「組み合わせで何ビットの情報量があるか」を概算してユニーク度を表示する。
 * 各項目のビット数は Panopticlick / EFF Cover Your Tracks の公開数値を参考にした上で
 * kako-jun のプロジェクトでは控えめに見積もる（合計を 0.7 倍する）。
 *
 *   Canvas hash       : 18 bit  (GPU + ドライバ + AA 設定で大きく分かれる)
 *   WebGL renderer    :  8 bit  (GPU / ドライバ世代の多様性)
 *   Fonts (count+ID)  : 12 bit  (OS + 国別追加フォントの組み合わせ)
 *   Screen + DPR      :  5 bit  (代表的な解像度クラスタが ~30 種)
 *   Timezone          :  5 bit  (代表的なゾーンが ~30 種)
 *   User-Agent        : 10 bit  (ブラウザ + バージョン + OS の組み合わせ)
 *   AudioContext      :  6 bit  (DSP 経路と CPU 由来の微小誤差)
 *   Languages         :  3 bit
 *   Hardware/Memory   :  3 bit
 *   Plugins/MimeTypes :  2 bit  (現代ブラウザでは枯れているが残骸が残る)
 *
 * 上限 64 bit、世界人口 ~80 億との比較で「N 人に 1 人」を表示する。
 */
interface Props {
  lang: 'ja' | 'en';
}

const { lang } = Astro.props;

const copy =
  lang === 'ja'
    ? {
